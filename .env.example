GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.8-flash

# En Mac local usar true (Ollama llama3.1:8b); en Ubuntu Server usar false
USE_LOCAL_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/llama3.1:8b

# Datos de marca por DEFECTO (opcionales). En la web se ingresan por video;
# si se dejan vacíos, no se mencionan en el audio ni en las descripciones.
STORE_NAME=Rulo Ecommerce
STORE_URL=rulo-ecommerce.com
WHATSAPP_NUMBER=72206808
# WHATSAPP_SPOKEN se deriva solo en pares (72 20 68 08); defínelo solo para forzarlo.
WHATSAPP_SPOKEN=
CITY_BASE=Cochabamba
COUNTRY=Bolivia

# Seguridad de acceso para la interfaz web móvil
STUDIO_PIN=2026

# Proveedor TTS ("edge" gratuito por defecto; preparado para "elevenlabs" o "fish")
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
